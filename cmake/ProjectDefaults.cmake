set(GAME_ENABLE_TESTING_DEFAULT OFF)
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(GAME_ENABLE_TESTING_DEFAULT ON) 
endif()

set(GAME_WARNINGS_AS_ERRORS_DEFAULT OFF)
if((CMAKE_BUILD_TYPE MATCHES "^(Release|MinSizeRel)$") AND (DEFINED ENV{CI}))
    set(GAME_WARNINGS_AS_ERRORS_DEFAULT ON)
endif()

set(GAME_ENABLE_IPO_DEFAULT OFF)
if(CMAKE_BUILD_TYPE MATCHES "^(Release|MinSizeRel)$")
    cmake_policy(SET CMP0069 NEW)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT GAME_ENABLE_IPO_DEFAULT)
endif()

